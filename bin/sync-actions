#!/bin/sh
set -eu

script_dir=${0%/*}
if [ "$script_dir" = "$0" ]; then
    script_dir=.
fi
root=$(cd "$script_dir/.." && pwd)

if [ "$#" -gt 0 ]; then
    type_dirs=
    for type_name in "$@"; do
        type_dirs="$type_dirs $root/types/$type_name"
    done
else
    type_dirs="$root"/types/*
fi

for type_dir in $type_dirs; do
    [ -d "$type_dir" ] || continue
    type_name=${type_dir##*/}
    conf=$type_dir/type.conf
    if [ ! -f "$conf" ]; then
        echo "skipping $type_name: missing type.conf" >&2
        continue
    fi

    container=
    max_cpu=
    max_fd=
    max_file_size=
    max_memory=
    max_threads=
    actions=
    . "$conf"

    if [ -z "$container" ]; then
        echo "error: $type_name missing container" >&2
        exit 1
    fi
    for name in max_cpu max_fd max_file_size max_memory max_threads; do
        eval "value=\${$name}"
        if [ -z "$value" ]; then
            echo "error: $type_name missing $name" >&2
            exit 1
        fi
    done

    tmp=${TMPDIR:-/tmp}/codegrinder-actions.$$
    : > "$tmp"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM

    printf '%s\n' "$actions" | while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            \#*) continue ;;
        esac
        old_ifs=$IFS
        IFS='|'
        set -- $line
        IFS=$old_ifs
        case "$#" in
            3)
                printf '%s|%s|%s|%s|%s|%s|%s|%s\n' \
                    "$1" "$2" "$3" "$max_cpu" "$max_fd" "$max_file_size" "$max_memory" "$max_threads" >> "$tmp"
                ;;
            8)
                printf '%s|%s|%s|%s|%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" >> "$tmp"
                ;;
            *)
                echo "error: $type_name invalid action: $line" >&2
                exit 1
                ;;
        esac
    done

    grind problemtype action set --problem-type "$type_name" --container "$container" --actions-file "$tmp"
    rm -f "$tmp"
    trap - EXIT HUP INT TERM
done
